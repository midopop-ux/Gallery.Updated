<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/dialog_scrollview"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/activity_margin"
        android:paddingTop="@dimen/medium_margin"
        android:paddingEnd="@dimen/activity_margin"
        android:paddingBottom="@dimen/medium_margin">

        <CheckBox
            android:id="@+id/change_date_taken_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/change_date_taken"
            android:textSize="@dimen/normal_text_size" />

        <LinearLayout
            android:id="@+id/date_taken_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_margin"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginBottom="@dimen/medium_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/date_taken_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="YYYY-MM-DD HH:MM:SS"
                android:inputType="datetime"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size" />

            <ImageView
                android:id="@+id/date_taken_picker_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_date_time"
                android:padding="8dp"
                android:src="@drawable/ic_calendar_vector" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/change_last_modified_checkbox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:checked="true"
            android:text="@string/change_last_modified"
            android:textSize="@dimen/normal_text_size" />

        <LinearLayout
            android:id="@+id/last_modified_holder"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/activity_margin"
            android:layout_marginTop="@dimen/small_margin"
            android:layout_marginBottom="@dimen/medium_margin"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/last_modified_edit_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="YYYY-MM-DD HH:MM:SS"
                android:inputType="datetime"
                android:maxLines="1"
                android:textSize="@dimen/normal_text_size" />

            <ImageView
                android:id="@+id/last_modified_picker_icon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/change_date_time"
                android:padding="8dp"
                android:src="@drawable/ic_calendar_vector" />
        </LinearLayout>

        <Button
            android:id="@+id/set_current_time_button"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/current_time" />

    </LinearLayout>
</ScrollView>
