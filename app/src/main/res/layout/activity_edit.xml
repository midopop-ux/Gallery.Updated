<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editor_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/editor_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:menu="@menu/menu_editor"
            app:title="@string/editor"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_edit_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Bottom panels container barrier -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottom_actions_barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="bottom_editor_primary_actions,
                                           bottom_aspect_ratios,
                                           bottom_editor_filter_actions,
                                           bottom_editor_crop_rotate_actions,
                                           bottom_editor_draw_actions,
                                           bottom_editor_adjust_actions,
                                           bottom_editor_sticker_actions" />

        <!-- 1. Central Image Viewport -->
        <ImageView
            android:id="@+id/default_image_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 2. Interactive Crop Image View -->
        <com.canhub.cropper.CropImageView
            android:id="@+id/crop_image_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:cropBackgroundColor="@color/crop_image_view_background"
            app:cropInitialCropWindowPaddingRatio="0"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 3. Interactive FreeStyle Overlay View -->
        <com.goodwy.gallery.views.FreeStyleOverlayView
            android:id="@+id/freestyle_overlay_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 4. Interactive Draw Canvas (Top transparent vector strokes overlay) -->
        <com.goodwy.gallery.views.EditorDrawCanvas
            android:id="@+id/editor_draw_canvas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/floating_bar_barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="bottom_actions_barrier,floating_layer_opacity_bar" />

        <!-- 5. Floating Compare Before/After Button -->
        <ImageView
            android:id="@+id/btn_compare_before_after"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="12dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/compare"
            android:padding="10dp"
            android:src="@drawable/ic_compare_vector"
            android:tint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@id/floating_bar_barrier"
            app:layout_constraintEnd_toEndOf="parent" />

        <RelativeLayout
            android:id="@+id/bottom_editor_actions_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_editor_actions_shadow_height"
            android:background="@drawable/gradient_background"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Panels Included -->
        <include
            android:id="@+id/bottom_editor_primary_actions"
            layout="@layout/bottom_editor_primary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

        <include
            android:id="@+id/bottom_aspect_ratios"
            layout="@layout/bottom_actions_aspect_ratio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_crop_rotate_actions" />

        <include
            android:id="@+id/bottom_editor_filter_actions"
            layout="@layout/bottom_editor_actions_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_crop_rotate_actions"
            layout="@layout/bottom_editor_crop_rotate_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_draw_actions"
            layout="@layout/bottom_editor_draw_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_adjust_actions"
            layout="@layout/bottom_editor_actions_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_sticker_actions"
            layout="@layout/bottom_editor_actions_sticker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <!-- Floating Layer Opacity & Actions Bar -->
        <LinearLayout
            android:id="@+id/floating_layer_opacity_bar"
            android:layout_width="0dp"
            android:layout_height="46dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_floating_layer_bar"
            android:elevation="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/floating_opacity_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/opacity"
                android:textColor="@android:color/white"
                android:textSize="12sp"
                android:textStyle="bold" />

            <SeekBar
                android:id="@+id/floating_opacity_slider"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="4dp"
                android:layout_weight="1"
                android:max="100"
                android:progress="100"
                android:progressTint="@color/theme_accent_color"
                android:thumbTint="@android:color/white" />

            <TextView
                android:id="@+id/floating_opacity_value"
                android:layout_width="40dp"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="100%"
                android:textColor="@color/theme_accent_color"
                android:textSize="12sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/floating_btn_bring_forward"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/bring_forward"
                android:padding="5dp"
                android:src="@drawable/ic_move_to_top_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/floating_btn_send_backward"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/send_backward"
                android:padding="5dp"
                android:src="@drawable/ic_move_to_bottom_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/floating_btn_duplicate"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/duplicate"
                android:padding="5dp"
                android:src="@drawable/ic_duplicate_vector"
                android:tint="@android:color/white" />

            <ImageView
                android:id="@+id/floating_btn_delete"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_marginStart="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete"
                android:padding="5dp"
                android:src="@drawable/ic_close_vector"
                android:tint="#FF5252" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
