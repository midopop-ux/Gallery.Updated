<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/editor_coordinator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/black">

    <com.goodwy.commons.views.MyAppBarLayout
        android:id="@+id/editor_appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/editor_toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:background="@android:color/transparent"
            app:menu="@menu/menu_editor"
            app:title="@string/editor"
            app:titleTextAppearance="@style/AppTheme.ActionBar.TitleTextStyle" />

    </com.goodwy.commons.views.MyAppBarLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/activity_edit_holder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <!-- Bottom panels container barrier -->
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/bottom_actions_barrier"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:barrierDirection="top"
            app:constraint_referenced_ids="bottom_editor_primary_actions,
                                           bottom_aspect_ratios,
                                           bottom_editor_filter_actions,
                                           bottom_editor_crop_rotate_actions,
                                           bottom_editor_draw_actions,
                                           bottom_editor_adjust_actions,
                                           bottom_editor_sticker_actions" />

        <!-- 1. Central Image Viewport -->
        <ImageView
            android:id="@+id/default_image_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 2. Interactive Crop Image View -->
        <com.canhub.cropper.CropImageView
            android:id="@+id/crop_image_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:cropBackgroundColor="@color/crop_image_view_background"
            app:cropInitialCropWindowPaddingRatio="0"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 3. Interactive Draw Canvas -->
        <com.goodwy.gallery.views.EditorDrawCanvas
            android:id="@+id/editor_draw_canvas"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 4. Interactive FreeStyle Overlay View -->
        <com.goodwy.gallery.views.FreeStyleOverlayView
            android:id="@+id/freestyle_overlay_view"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.5" />

        <!-- 5. Floating Compare Before/After Button -->
        <ImageView
            android:id="@+id/btn_compare_before_after"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="Compare"
            android:padding="10dp"
            android:src="@drawable/ic_compare_vector"
            android:tint="@android:color/white"
            app:layout_constraintBottom_toTopOf="@id/bottom_actions_barrier"
            app:layout_constraintEnd_toEndOf="parent" />

        <RelativeLayout
            android:id="@+id/bottom_editor_actions_background"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bottom_editor_actions_shadow_height"
            android:background="@drawable/gradient_background"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Panels Included -->
        <include
            android:id="@+id/bottom_editor_primary_actions"
            layout="@layout/bottom_editor_primary_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent" />

        <include
            android:id="@+id/bottom_aspect_ratios"
            layout="@layout/bottom_actions_aspect_ratio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_crop_rotate_actions" />

        <include
            android:id="@+id/bottom_editor_filter_actions"
            layout="@layout/bottom_editor_actions_filter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_crop_rotate_actions"
            layout="@layout/bottom_editor_crop_rotate_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_draw_actions"
            layout="@layout/bottom_editor_draw_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_adjust_actions"
            layout="@layout/bottom_editor_actions_adjust"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

        <include
            android:id="@+id/bottom_editor_sticker_actions"
            layout="@layout/bottom_editor_actions_sticker"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintBottom_toTopOf="@id/bottom_editor_primary_actions" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
