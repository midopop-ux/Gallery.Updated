<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/videoEditorRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212">

    <!-- Top Toolbar -->
    <RelativeLayout
        android:id="@+id/editorTopBar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:paddingStart="8dp"
        android:paddingEnd="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="12dp"
            android:src="@drawable/ic_chevron_left_vector"
            app:tint="#FFFFFF"
            tools:ignore="ContentDescription" />

        <TextView
            android:id="@+id/editorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text="@string/trim_video"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- Video Preview Area -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/videoPreviewHolder"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="#000000"
        app:layout_constraintTop_toBottomOf="@id/editorTopBar"
        app:layout_constraintBottom_toTopOf="@id/bottomControlsCard">

        <TextureView
            android:id="@+id/editorVideoSurface"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Overlay Floating Media Controls -->
        <LinearLayout
            android:id="@+id/previewOverlayControls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent">

            <ImageView
                android:id="@+id/btnToggleMute"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_button"
                android:padding="8dp"
                android:src="@drawable/ic_volume_up_vector"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnPlayPause"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_circle_button"
                android:padding="12dp"
                android:src="@drawable/ic_play_vector"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/btnFullscreen"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_circle_button"
                android:padding="8dp"
                android:src="@drawable/ic_fullscreen_vector"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom Controls Container (Dark Sheet) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomControlsCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1C1C1E"
        android:paddingTop="12dp"
        android:paddingBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Time Labels Row (Start Time | Total Duration | End Time) -->
        <TextView
            android:id="@+id/tvStartTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total 00:00:00"
            android:textColor="#AAAAAA"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvStartTime"
            app:layout_constraintEnd_toStartOf="@id/tvEndTime"
            app:layout_constraintTop_toTopOf="@id/tvStartTime"
            app:layout_constraintBottom_toBottomOf="@id/tvStartTime" />

        <TextView
            android:id="@+id/tvEndTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_pill_button"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="00:00:00"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Timeline Frame Holder with Start/End Draggable Handles -->
        <FrameLayout
            android:id="@+id/timelineContainer"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvStartTime">

            <!-- Filmstrip Thumbnails Track -->
            <LinearLayout
                android:id="@+id/filmstripLayout"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="horizontal"
                android:background="#2C2C2E" />

            <!-- Highlighted Selected Range Rect -->
            <View
                android:id="@+id/trimHighlightRect"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_trim_segment" />

            <!-- Left Drag Handle (Start Cut) -->
            <ImageView
                android:id="@+id/handleStart"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_trim_handle_start"
                android:src="@drawable/ic_chevron_left_vector"
                android:scaleType="centerInside"
                android:padding="2dp"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />

            <!-- Right Drag Handle (End Cut) -->
            <ImageView
                android:id="@+id/handleEnd"
                android:layout_width="26dp"
                android:layout_height="match_parent"
                android:background="@drawable/bg_trim_handle_end"
                android:src="@drawable/ic_chevron_right_vector"
                android:scaleType="centerInside"
                android:padding="2dp"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Precision Fine-tuning (+ / -) Row -->
        <LinearLayout
            android:id="@+id/precisionControlsRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:gravity="center_vertical"
            app:layout_constraintTop_toBottomOf="@id/timelineContainer">

            <!-- Left Handle Controls: Minus / Plus -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/btnStartMinus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_minus_vector"
                    app:tint="#FFFFFF"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnStartPlus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_plus_vector"
                    app:tint="#FFFFFF"
                    tools:ignore="ContentDescription" />
            </LinearLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Right Handle Controls: Minus / Plus -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_button"
                android:orientation="horizontal"
                android:padding="2dp">

                <ImageView
                    android:id="@+id/btnEndMinus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_minus_vector"
                    app:tint="#FFFFFF"
                    tools:ignore="ContentDescription" />

                <ImageView
                    android:id="@+id/btnEndPlus"
                    android:layout_width="34dp"
                    android:layout_height="30dp"
                    android:padding="6dp"
                    android:src="@drawable/ic_plus_vector"
                    app:tint="#FFFFFF"
                    tools:ignore="ContentDescription" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tool Selection Pills (Trim | Crop | Speed) -->
        <LinearLayout
            android:id="@+id/toolsSelectorRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintTop_toBottomOf="@id/precisionControlsRow">

            <TextView
                android:id="@+id/tabTrim"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_pill_button_selected"
                android:gravity="center"
                android:text="@string/trim_video"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabCrop"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:layout_marginEnd="3dp"
                android:background="@drawable/bg_pill_button"
                android:gravity="center"
                android:text="@string/crop"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tabSpeed"
                android:layout_width="0dp"
                android:layout_height="38dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_button"
                android:gravity="center"
                android:text="@string/speed"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Speed Selection Options (Visible when tabSpeed is active) -->
        <RadioGroup
            android:id="@+id/speedOptionsGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginStart="20dp"
            android:layout_marginTop="12dp"
            android:layout_marginEnd="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/toolsSelectorRow">

            <RadioButton
                android:id="@+id/speed05x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="0.5x"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/speed1x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:checked="true"
                android:text="1.0x"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/speed15x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="1.5x"
                android:textColor="#FFFFFF" />

            <RadioButton
                android:id="@+id/speed2x"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="2.0x"
                android:textColor="#FFFFFF" />
        </RadioGroup>

        <!-- Save Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveEditedVideo"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginTop="16dp"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:text="@string/save"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="24dp"
            app:icon="@drawable/ic_check_vector"
            app:backgroundTint="#3D82F6"
            app:layout_constraintTop_toBottomOf="@id/speedOptionsGroup"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
