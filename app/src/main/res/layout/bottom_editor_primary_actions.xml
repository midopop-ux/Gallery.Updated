<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/bottom_editor_primary_actions_wrapper"
    android:layout_width="match_parent"
    android:layout_height="56dp"
    android:background="#DD181818"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/bottom_primary_cancel"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="16dp"
        android:paddingEnd="12dp"
        android:text="@string/cancel"
        android:textColor="#BBFFFFFF"
        android:textSize="15sp" />

    <!-- Center tab icons with equal distribution -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- 1. Crop / Transform -->
        <ImageView
            android:id="@+id/bottom_primary_crop_rotate"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/transform"
            android:padding="10dp"
            android:src="@drawable/ic_crop_rotate_vector"
            android:tint="@android:color/white" />

        <!-- 2. Adjust (Color & Light) -->
        <ImageView
            android:id="@+id/bottom_primary_adjust"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Adjust"
            android:padding="10dp"
            android:src="@drawable/ic_tune_vector"
            android:tint="@android:color/white" />

        <!-- 3. Filters -->
        <ImageView
            android:id="@+id/bottom_primary_filter"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/filter"
            android:padding="10dp"
            android:src="@drawable/ic_photo_filter_vector"
            android:tint="@android:color/white" />

        <!-- 4. Markup / Draw -->
        <ImageView
            android:id="@+id/bottom_primary_draw"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/draw"
            android:padding="10dp"
            android:src="@drawable/ic_easel"
            android:tint="@android:color/white" />

        <!-- 5. FreeStyle / Sticker Overlay -->
        <ImageView
            android:id="@+id/bottom_primary_sticker"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="8dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Stickers"
            android:padding="10dp"
            android:src="@drawable/ic_sticker_vector"
            android:tint="@android:color/white" />
    </LinearLayout>

    <TextView
        android:id="@+id/bottom_primary_save"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="center"
        android:paddingStart="12dp"
        android:paddingEnd="16dp"
        android:text="@string/save"
        android:textColor="@color/theme_accent_color"
        android:textSize="15sp"
        android:textStyle="bold" />

</LinearLayout>
